# Copy to `.env.local` for development, and set the same keys in your hosting
# provider's environment settings for production. `.env*` is gitignored — this
# template is the only one of these files that belongs in the repository.

# ─── Required in production ──────────────────────────────────────────────────

# The public origin, no trailing slash. Every canonical URL, Open Graph image,
# sitemap entry and robots directive is built from it.
#
# In production this is set in apphosting.yaml, where it MUST be declared
# `availability: [BUILD, RUNTIME]` — the pages are prerendered, so a
# runtime-only value never reaches the canonical tags. This file is for local
# development only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Optional ────────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID (`G-XXXXXXXXXX`). Set in apphosting.yaml for
# production. LEAVE IT EMPTY HERE: with no value the layout mounts no tag at
# all, so local page loads never reach Google — which is what you want, since a
# development session that did would land in the same property as real traffic
# and skew it. Set it temporarily if you need to debug the tag itself.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID (`xytc24b20t` in production). Set in
# apphosting.yaml for production. LEAVE IT EMPTY HERE, for the same reason as
# the GA ID above and one more: Clarity records session replays, so a local
# value would upload footage of you editing the site into the same dashboard as
# real visitor sessions. Set it temporarily only to debug the tag itself.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ─── Contact form delivery (set at least one group) ──────────────────────────
#
# With neither configured the form is refused: /api/contact answers 502 and the
# visitor is sent to the studio email. The enquiry is written to the runtime
# logs so it can be recovered, but nothing is delivered and nobody is told it
# arrived. See lib/contact-delivery.ts.

# Email, via Resend (https://resend.com). CONTACT_FROM_EMAIL must be on a domain
# verified in the Resend dashboard or every send is rejected.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@southeastmedia.in
CONTACT_FROM_EMAIL=Southeast Media <enquiries@southeastmedia.in>

# Or POST each enquiry as JSON. Works as-is with a Slack or Teams incoming
# webhook. Can be set alongside the email transport.
CONTACT_WEBHOOK_URL=
